  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.10.0",
    "@types/nodemailer": "^8.0.1",
    "better-auth": "^1.6.25",
    "cors": "^2.8.6",
